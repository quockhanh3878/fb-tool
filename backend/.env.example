# ============================================================
# CommHunter AI - Backend .env
# Copy file nay thanh .env roi dien gia tri that.
# ============================================================

# --- Database ---
# Dev (khong can Docker):
# DATABASE_URL=sqlite+aiosqlite:///./data/commhunter_api.db
# Production (docker compose):
DATABASE_URL=postgresql+asyncpg://commhunter:commhunter@db:5432/commhunter

# --- Redis (broker cho Celery) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Sinh khoa moi: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-khoa-nay-truoc-khi-chay-that
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Ma hoa cookie clone (Fernet) ---
# Sinh khoa: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# De TRONG = sinh khoa tam trong RAM, restart la mat cookie -> chi dung khi dev.
COOKIE_ENCRYPTION_KEY=

# --- CORS (dia chi dashboard) ---
CORS_ORIGINS=http://localhost:3000

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Duong dan profile trinh duyet cua clone ---
BROWSER_PROFILES_ROOT=./data/profiles
